# ==============================================================================
# Aura Enterprise Engine — Environment Configuration Template
# Safe placeholder values for local development and deployment configuration
# Copy this file to .env and configure for your local environment
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB 6.0+ compatible local instance or Atlas URI)
# Example local: mongodb://localhost:27017/aura_enterprise
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/aura_enterprise?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/aura_enterprise

# Security & CORS Whitelist Configuration
# Specifies the allowed frontend client origin
CORS_ORIGIN=http://localhost:5173

# Frontend Environment Variables (Sprint 19 RapidDispatch Live Ops)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
